# Application Settings
PROJECT_NAME="Diamond CX Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Server Configuration
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Google Agent Development Kit / Gemini API
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
LIVE_VOICE_NAME="Puck"
LIVE_RESPONSE_MODALITY="AUDIO"

# Google Cloud & Vertex AI Vector Search 2.0
GOOGLE_GENAI_USE_VERTEXAI="TRUE"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
VECTOR_SEARCH_COLLECTION_ID="diamond-cx-knowledge"
EMBEDDING_MODEL="gemini-embedding-2-preview"
EMBEDDING_DIMENSION=768
KNOWLEDGE_STORE_PATH="data/knowledge_store.json"
